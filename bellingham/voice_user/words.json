"text": "toda su carrera."
},
{
"start": 6.02,
"end": 7.38,
"text": "Todo empieza en esta jugada."
},
{
"start": 7.74,
"end": 9.96,
"text": "Cuando Bernardo Silva avanza con el balón,"
},
{
"start": 10.22,
"end": 12.46,
"text": "y decide abrir por la banda para Vinicius."
},
{
"start": 12.98,
"end": 15.66,
"text": "Este recibe y se lanza hacia el área rival."
},
{
"start": 16.22,
"end": 17.02,
"text": "En ese momento,"
},
{
"start": 17.26,
"end": 20.2,
"text": "Un defensor le cierra el paso y la impide entrar directamente."
},
{
"start": 20.32,
"end": 21.16,
"text": "a la área."
},
{
"start": 21.72,
"end": 24.42,
"text": "Los defensores creen que va a jugar aquí con Cucurella."
},
{
"start": 24.78,
"end": 27.5,
"text": "pero decide devolverle el balón a Bernardo Silva."
},
{
"start": 27.72,
"end": 28.48,
"text": "fuera del área."
},
{
"start": 29.08,
"end": 32.46,
"text": "Bernardo recibe el pase y se perfila para jugar con la zurda."
},
{
"start": 32.98,
"end": 34.3,
"text": "Papel le pide el balón."
},
{
"start": 34.58,
"end": 37.06,
"text": "pero él decide abrir por la banda para Kukureya."
},
{
"start": 37.6,
"end": 39.12,
"text": "En cuanto Cucurella recibe,"
},
{
"start": 39.3,
"end": 40.98,
"text": "Avanza y entra al área."
},
{
"start": 41.56,
"end": 44.38,
"text": "Fíjate en la posición de los defensores del AECA."
},
{
"start": 44.86,
"end": 46.16,
"text": "están bien alineados."
},
{
"start": 46.38,
"end": 50.28,
"text": "y se concentran principalmente en marcar a los jugadores del Real Madrid,"
},
{
"start": 50.48,
"end": 51.86,
"text": "que están dentro del área."
},
{
"start": 52.42,
"end": 54.56,
"text": "Piensan que Kukureya va a mandar un centro."
},
{
"start": 54.86,
"end": 56.08,
"text": "por eso intentan cubrir"
},
{
"start": 56.24,
"end": 57.36,
"text": "todos los espacios."
},
{
"start": 57.86,
"end": 59.8,
"text": "Pero Cucurella decide no centrar."
},
{
"start": 60.34,
"end": 61.44,
"text": "En el último momento,"
},
{
"start": 61.68,
"end": 64.32,
"text": "Levanta la cabeza y ve a Bellingham llegando a"
},
{
"start": 64.46,
"end": 65.24,
"text": "toda velocidad."
},
{
"start": 65.82,
"end": 66.44,
"text": "Entonces,"
},
{
"start": 66.64,
"end": 68.76,
"text": "Decide darle un pase dentro del área."
},
{
"start": 69.24,
"end": 71.56,
"text": "y Bellingham ni siquiera controla el balón."
},
{
"start": 71.94,
"end": 72.96,
"text": "Remata de tacón."
},
{
"start": 73.12,
"end": 73.92,
"text": "y lo manda directo"
},
{
"start": 74.06,
"end": 75.44,
"text": "justamente al fondo de la red."
}
